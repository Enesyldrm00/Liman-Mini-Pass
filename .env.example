# Copy to .env for running apps on the host. Inside Docker Compose these are set in
# infra/compose/compose.yaml. Keep this file in sync with ROADMAP section 15.
# Never commit real values: .env and secrets/ are git-ignored.

NODE_ENV=development
LOG_LEVEL=info
# API listen port.
PORT=3000

# Panel origin; used for Origin checks and redirects.
LIMAN_PUBLIC_URL=http://liman.localhost
# Apps are served at <subdomain>.<LIMAN_BASE_DOMAIN>.
LIMAN_BASE_DOMAIN=localhost

# Local stack from infra/compose (Postgres is published on host port 5433).
DATABASE_URL=postgres://liman:liman@localhost:5433/liman
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64: openssl rand -base64 32
# If this key is lost, stored env values cannot be decrypted.
LIMAN_ENCRYPTION_KEY=
# Comma-separated GitHub user IDs (not logins) allowed to sign in.
LIMAN_ALLOWED_GITHUB_IDS=12345678
SESSION_TTL_HOURS=168

# GitHub App (docs/github-app-setup.md).
GITHUB_APP_ID=
# Used for the installation link.
GITHUB_APP_SLUG=liman-dev
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Kept outside the repository.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/app.pem
GITHUB_WEBHOOK_SECRET=
# Development only: forwards GitHub webhooks to localhost.
SMEE_URL=https://smee.io/your-channel

REGISTRY_HOST=localhost:5000

# Worker.
WORKER_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=600
DEPLOY_HEALTH_TIMEOUT_SECONDS=60
# Phase 2: buildah-job / kubernetes.
BUILDER=docker
DEPLOYER=docker

# Phase 1.
TRAEFIK_DYNAMIC_DIR=/traefik/dynamic
APP_DEFAULT_MEMORY_MB=256
APP_DEFAULT_CPUS=0.5
