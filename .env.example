# Copy to .env for running apps on the host. Inside Docker Compose these are set in
# infra/compose/compose.yaml. The full list (ROADMAP section 15) is completed in 0.5.

NODE_ENV=development
LOG_LEVEL=info
LIMAN_PUBLIC_URL=http://liman.localhost

# Local stack from infra/compose (Postgres is published on host port 5433).
DATABASE_URL=postgres://liman:liman@localhost:5433/liman
REDIS_URL=redis://localhost:6379
