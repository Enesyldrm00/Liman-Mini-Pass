{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    // Resolve workspace packages to their TypeScript sources, so type-checking
    // does not need a prior build. Builds (tsconfig.build.json) use dist/.
    "customConditions": ["liman-source"]
  },
  "include": ["src", "vitest.config.ts"]
}
